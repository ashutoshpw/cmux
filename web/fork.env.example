# Public fork configuration. Store actual secrets in Vercel/GitHub/Worker stores.
# This example is not loaded automatically.
CMUX_APP_ORIGIN=https://cmux.w3dev.app
BETTER_AUTH_URL=https://cmux.w3dev.app
CMUX_DB_DRIVER=url
DATABASE_URL=
BETTER_AUTH_SECRET=
# Verified Resend sender for verification, OTP, password reset, invitations.
RESEND_API_KEY=
CMUX_AUTH_FROM_EMAIL=
# Optional social providers: configure each pair together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dedicated server-to-Worker current-session authority; at least 32 characters.
CMUX_AUTH_SERVICE_KEY=
# Explicit operators and delivery recipients; empty means unavailable.
CMUX_ADMIN_EMAIL_DOMAINS=
CMUX_SUPPORT_TO_EMAIL=
CMUX_ENTERPRISE_TO_EMAIL=
CMUX_FEEDBACK_TO_EMAIL=
CMUX_FEEDBACK_FROM_EMAIL=
CMUX_FOUNDERS_FROM_EMAIL=
CMUX_PRO_FROM_EMAIL=
CMUX_TEAM_INVITE_FROM_EMAIL=
# Configure VM/provider/Stripe/APNs/relay settings only for owned enabled services.
# No fork image is promoted by default. Bake and verify before promotion.
FREESTYLE_API_KEY=
CRON_SECRET=
# Verify the fork browser update signature using its own key.
CMUX_BROWSER_UPDATE_PUBLIC_KEY_PEM=
